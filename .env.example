# -----------------------------------------------------------------------------
# GIA PHẢ OS - Environment Variables (Cloudflare + D1)
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development
# For production, set these as Cloudflare Pages environment variables

# Site name displayed to users
SITE_NAME="Gia Phả OS"

# Public URL of your deployment
APP_URL="https://your-domain.pages.dev"

# Resend (https://resend.com) for admin email notifications
RESEND_API_KEY="re_your-api-key"
RESEND_FROM_EMAIL="Gia Phả OS <no-reply@your-verified-domain.com>"

# Optional: admin notification email. If empty, all active admins receive emails.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# NOTE: Cloudflare D1 binding (DB) and R2 binding (STORAGE) are configured
# in wrangler.jsonc and are NOT environment variables.
